# MongoDB Atlas connection string (Atlas is required for Vector Search + transactions)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="knowledge_assistant"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Embedding provider: "Groq" or "OpenAI" (case-insensitive).
#   Groq   -> https://api.groq.com/openai/v1, nomic-embed-text-v1_5, 768 dims, needs GROQ_API_KEY
#   OpenAI -> https://api.openai.com/v1,      text-embedding-3-small, 1536 dims, needs OPENAI_API_KEY
AI_PROVIDER="OpenAI"
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Optional overrides. Leave unset to use the provider defaults above.
# Changing the model or dimensions requires `npm run db:indexes` and re-uploading documents.
# EMBEDDING_MODEL=""
# EMBEDDING_DIMENSIONS=""
# AI_BASE_URL=""            # e.g. an OpenAI-compatible proxy
VECTOR_INDEX_NAME="chunk_vector_index"
