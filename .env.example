# MongoDB Atlas connection string (Atlas is required for Vector Search + transactions)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="knowledge_assistant"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Embeddings — must match the model used during ingestion and the vector index.
# Changing EMBEDDING_DIMENSIONS requires re-running `npm run db:indexes` and re-embedding.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL="voyage-3.5"
VECTOR_INDEX_NAME="chunk_vector_index"
